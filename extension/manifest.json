{
  "manifest_version": 3,
  "name": "Magic Theme for Phocas",
  "short_name": "Phocas Magic",
  "version": "3.0.0",
  "description": "A modern, Apple-inspired look for Phocas BI, with searchable pickers, data bars and reorderable columns. Unofficial.",
  "minimum_chrome_version": "120",
  "homepage_url": "https://github.com/roach0123/phocas-magic",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Magic Theme for Phocas",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.phocassoftware.com/*"
      ],
      "css": [
        "css/00-tokens.css",
        "css/10-base.css",
        "css/20-shell.css",
        "css/30-controls.css",
        "css/40-grid.css",
        "css/45-charts.css",
        "css/50-dashboard.css",
        "css/60-analytics.css",
        "css/65-flex.css",
        "css/70-apps.css",
        "css/80-overlays.css",
        "css/90-enhance.css",
        "css/95-signature.css"
      ],
      "js": [
        "js/pm.js",
        "js/recolor.js",
        "js/menus.js",
        "js/bars.js",
        "js/total.js",
        "js/columns.js",
        "js/charts.js",
        "js/dimorder.js",
        "js/muimenus.js",
        "js/listsearch.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "exclude_matches": [
        "https://*.phocassoftware.com/admin/*",
        "https://*.phocassoftware.com/Admin/*",
        "https://*.phocassoftware.com/ADMIN/*",
        "https://*.phocassoftware.com/administration/*",
        "https://*.phocassoftware.com/Administration/*",
        "https://*.phocassoftware.com/ADMINISTRATION/*",
        "https://*.phocassoftware.com/admin",
        "https://*.phocassoftware.com/Admin",
        "https://*.phocassoftware.com/ADMIN",
        "https://*.phocassoftware.com/administration",
        "https://*.phocassoftware.com/Administration",
        "https://*.phocassoftware.com/ADMINISTRATION",
        "https://*.phocassoftware.com/admin?*",
        "https://*.phocassoftware.com/Admin?*",
        "https://*.phocassoftware.com/ADMIN?*",
        "https://*.phocassoftware.com/administration?*",
        "https://*.phocassoftware.com/Administration?*",
        "https://*.phocassoftware.com/ADMINISTRATION?*",
        "https://*.phocassoftware.com/designer*",
        "https://*.phocassoftware.com/*/designer*",
        "https://*.phocassoftware.com/Designer*",
        "https://*.phocassoftware.com/*/Designer*",
        "https://*.phocassoftware.com/DESIGNER*",
        "https://*.phocassoftware.com/*/DESIGNER*"
      ]
    }
  ],
  "host_permissions": [
    "https://*.phocassoftware.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "options_page": "options.html"
}
